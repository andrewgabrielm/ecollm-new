# Defaults are safe for offline development; keys stay blank and environment-only.
MOCK_MODE=1
CLOUD_API_KEY=
LOCAL_WRITE_TOKEN=
# Optional owner-only local runtime settings; no runtime is started automatically.
OLLAMA_ENDPOINT=http://127.0.0.1:11434
# Declare the running daemon's actual model store for disk checks; this does not configure Ollama.
MODEL_STORE=
# --- Optional cloud fallback (owner-run only; declare the destination in settings.yaml) ---
# Example for xAI Grok free tier. Match the variable name to whatever
# api_key_variable your settings.yaml cloud_destination declares. The adapter
# reads only the env variable value and stores it in a SecretStr; it is never
# logged, serialized or sent anywhere except in the Authorization header.
XAI_API_KEY=
